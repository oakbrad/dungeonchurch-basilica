{{!-- 
    WIKI ORACLE PARTIAL
    
    This partial embeds the Dungeon Church Oracle in a regular content width iframe.
    
    USAGE:
    {{> "wiki-oracle"}}
    
    With custom height:
    {{> "wiki-oracle" height="800"}}
    
    With custom mobile height (for screens smaller than 768px):
    {{> "wiki-oracle" height="800" mobileHeight="500"}}
--}}

<style>
    .wiki-oracle-container {
        width: 100%;
        margin: 2rem 0;
        border-radius: 5px;
        overflow: hidden;
    }
    
    .wiki-oracle-container iframe {
        width: 100%;
        height: {{#if height}}{{height}}px{{else}}600px{{/if}};
        border: 1px solid var(--ghost-accent-color);
        border-radius: 5px;
    }
    
    /* Add responsive height adjustments */
    @media (max-width: 768px) {
        .wiki-oracle-container iframe {
            height: {{#if mobileHeight}}{{mobileHeight}}px{{else}}{{#if height}}{{height}}px{{else}}420px{{/if}}{{/if}};
        }
    }
</style>

<div class="wiki-oracle-container">
    <iframe src="https://oakbrad.github.io/dungeonchurch-oracle/" title="Dungeon Church Wiki Oracle" allowfullscreen></iframe>
</div>

