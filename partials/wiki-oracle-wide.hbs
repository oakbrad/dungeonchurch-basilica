{{!-- 
    WIKI ORACLE WIDE PARTIAL
    
    This partial embeds the Dungeon Church Oracle in a full-width iframe that extends to the edges of the viewport.
    
    USAGE:
    {{> "wiki-oracle-wide"}}
    
    With custom height:
    {{> "wiki-oracle-wide" height="800"}}
    
    With custom mobile height (for screens smaller than 768px):
    {{> "wiki-oracle-wide" height="800" mobileHeight="500"}}
--}}

<style>
    .wiki-oracle-wide-container {
        position: relative;
        left: 50%;
        width: 100vw;
        max-width: 100vw;
        transform: translateX(-50%);
        box-sizing: border-box;
        padding: 0;
        margin: 2rem 0;
        overflow: hidden !important;
    }
    
    .wiki-oracle-wide-container iframe {
        width: 100%;
        height: {{#if height}}{{height}}px{{else}}600px{{/if}};
        border: 0px solid var(--color-border);
        border-radius: 0;
    }
    
    /* Add responsive height adjustments */
    @media (max-width: 768px) {
        .wiki-oracle-wide-container iframe {
            height: {{#if mobileHeight}}{{mobileHeight}}px{{else}}{{#if height}}{{height}}px{{else}}420px{{/if}}{{/if}};
        }
    }
</style>

<div class="wiki-oracle-wide-container">
    <iframe src="https://oakbrad.github.io/dungeonchurch-oracle/" title="Dungeon Church Wiki Oracle (Wide View)" allowfullscreen></iframe>
</div>

