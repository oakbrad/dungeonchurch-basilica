<!-- Timeline Component -->
<link rel="stylesheet" href="{{asset 'timelinejs/css/timeline.css'}}">
<link rel="stylesheet" href="{{asset 'timeline.css'}}">

<style>
  #timeline-embed {
    flex: 1 1 0;
    min-height: 0;
    width: 100%;
    overflow: hidden;  /* Prevent TimelineJS from extending beyond container */
  }

  /* Force TimelineJS internal elements to respect container height */
  #timeline-embed .tl-timeline {
    height: 100% !important;
    max-height: 100% !important;
  }

  #timeline-embed .tl-timeline-container {
    height: 100% !important;
  }

  /* Hide the data container - it's only used for extracting the sheet URL */
  .timeline-data-container {
    display: none !important;
  }
</style>

<div id="timeline-embed"></div>
<div class="timeline-data-container">{{content}}</div>

<script src="{{asset 'timelinejs/js/timeline.js'}}"></script>

<script>
  // Initialize timeline when DOM is ready
  document.addEventListener("DOMContentLoaded", function() {
    const timelineEmbed = document.getElementById('timeline-embed');
    if (!timelineEmbed) {
      console.error('[Timeline] Could not find #timeline-embed element');
      return;
    }

    // Get timeline data URL - check post content first, then fall back to meta tag
    const sheetUrl = extractSheetUrl();

    if (sheetUrl) {
      try {
        // Create timeline with configuration
        window.timeline = new TL.Timeline('timeline-embed', sheetUrl, {
          timenav_position: "bottom",
          initial_zoom: 4,
          scale_factor: 2,
          zoom_sequence: [1,2,3],
          start_at_slide: 0,
          use_bc: false,
          hash_bookmark: false,
          lang: "/assets/timelinejs/timeline-locale.json",
        });

        // Set up BCE date removal
        setupBCERemoval();

        // Set up height management for mobile browsers
        setupTimelineHeight();
      } catch (error) {
        console.error('[Timeline] Failed to initialize:', error);
        timelineEmbed.innerHTML = `
          <div class="timeline-access-message">
            <h1>Timeline Couldn't Be Loaded</h1>
            <p>Try refreshing the page.</p>
          </div>
        `;
      }
    } else {
      console.warn('[Timeline] No sheet URL found. Add meta tag: <meta name="custom:sheet_url" content="...">');
      timelineEmbed.innerHTML = `
        <div class="timeline-access-message">
          <h1>Timeline Couldn't Be Loaded</h1>
          <p>Missing timeline URL. The post needs a meta tag with the Google Sheet URL.</p>
        </div>
      `;
    }
  });
  
  // Remove BCE dates and set up observer to keep them removed
  function setupBCERemoval() {
    // Check for timeline ticks every 200ms
    const checkInterval = setInterval(() => {
      const ticks = document.querySelectorAll('.tl-timeaxis-tick');
      
      if (ticks.length > 0) {
        clearInterval(checkInterval);
        
        // Remove BCE ticks (negative positions)
        removeBCETicks();
        
        // Watch for timeline changes and remove BCE ticks when they appear
        const axis = document.querySelector('.tl-timeaxis-content-container');
        if (axis) {
          const observer = new MutationObserver(removeBCETicks);
          observer.observe(axis, { childList: true, subtree: true });
        }
      }
    }, 200);
    
    // Stop checking after 5 seconds to prevent infinite loop
    setTimeout(() => clearInterval(checkInterval), 5000);
  }
  
  // Remove timeline ticks with negative positions (BCE dates)
  function removeBCETicks() {
    document.querySelectorAll('.tl-timeaxis-tick').forEach(tick => {
      const left = parseFloat(tick.style.left);
      if (left < 0) tick.remove();
    });
  }

  // Set up height management for mobile browsers
  function setupTimelineHeight() {
    function adjustTimelineHeight() {
      const container = document.getElementById('timeline-embed');
      if (!container) return;

      // Get the viewport height (use visualViewport for mobile accuracy)
      const viewportHeight = window.visualViewport
        ? window.visualViewport.height
        : window.innerHeight;

      // Get container's position from top of viewport
      const containerTop = container.getBoundingClientRect().top;

      // Calculate available height (viewport minus header/nav above)
      const availableHeight = Math.max(viewportHeight - containerTop, 300);

      // Set both height and max-height to force constraint
      container.style.height = availableHeight + 'px';
      container.style.maxHeight = availableHeight + 'px';

      // Also force the inner timeline element if it exists
      const innerTimeline = container.querySelector('.tl-timeline');
      if (innerTimeline) {
        innerTimeline.style.height = availableHeight + 'px';
        innerTimeline.style.maxHeight = availableHeight + 'px';
      }
    }

    // Initial adjustment - wait longer for TimelineJS to fully render
    setTimeout(adjustTimelineHeight, 500);

    // Re-adjust on resize and orientation change
    window.addEventListener('resize', adjustTimelineHeight);
    window.addEventListener('orientationchange', function() {
      setTimeout(adjustTimelineHeight, 300);
    });

    // Listen to visualViewport resize (fires on address bar show/hide)
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', adjustTimelineHeight);
    }
  }

  // Extract Google Sheet URL from post content or meta tag
  // Priority: 1. Bookmark card in content, 2. Meta tag injection
  function extractSheetUrl() {
    const dataContainer = document.querySelector('.timeline-data-container');

    if (dataContainer) {
      // Look for a Ghost bookmark card with a Google Sheets URL
      // When you paste a Google Sheet link, Ghost creates a bookmark card
      const bookmarkLink = dataContainer.querySelector('.kg-bookmark-card a.kg-bookmark-container');
      if (bookmarkLink && bookmarkLink.href) {
        const href = bookmarkLink.href;
        // Check if it's a Google Sheets URL
        if (href.includes('docs.google.com/spreadsheets')) {
          console.log('[Timeline] Found Google Sheet URL in post content');
          return href;
        }
      }

      // Also check for a simple link to Google Sheets (in case it wasn't converted to bookmark)
      const allLinks = dataContainer.querySelectorAll('a');
      for (const link of allLinks) {
        if (link.href && link.href.includes('docs.google.com/spreadsheets')) {
          console.log('[Timeline] Found Google Sheet URL in post link');
          return link.href;
        }
      }
    }

    // Fall back to meta tag (for code injection method)
    const metaTag = document.querySelector('meta[name="custom:sheet_url"]');
    if (metaTag && metaTag.content) {
      console.log('[Timeline] Found Google Sheet URL in meta tag');
      return metaTag.content;
    }

    return null;
  }
</script>

