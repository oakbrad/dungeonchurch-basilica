{{!< default}}
{{#contentFor "title"}}Table Roller{{/contentFor}}
{{!-- The tag above means: insert everything in this file
into the {body} of the default.hbs template --}}

<div class="site-header-content outer{{#match @custom.header_style "Left aligned"}} left-aligned{{/match}}{{#unless @custom.show_publication_cover}}{{#match @custom.header_style "Hidden"}} no-content{{/match}}{{/unless}}">

    {{#if @custom.show_publication_cover}}
        {{#if @site.cover_image}}
            {{!-- This is a responsive image, it loads different sizes depending on device
            https://medium.freecodecamp.org/a-guide-to-responsive-images-with-ready-to-use-templates-c400bd65c433 --}}
            <img class="site-header-cover"
                srcset="{{img_url @site.cover_image size="s"}} 300w,
                        {{img_url @site.cover_image size="m"}} 600w,
                        {{img_url @site.cover_image size="l"}} 1000w,
                        {{img_url @site.cover_image size="xl"}} 2000w"
                sizes="100vw"
                src="{{img_url @site.cover_image size="xl"}}"
                alt="{{@site.title}}"
            />
        {{/if}}
    {{/if}}

    {{#match @custom.header_style "!=" "Hidden"}}
        <div class="site-header-inner inner">
            {{#match @custom.navigation_layout "Logo on cover"}}
                {{#if @site.logo}}
                    <img class="site-logo" src="{{@site.logo}}" alt="{{@site.title}}">
                {{else}}
                    <h1 class="site-title">{{@site.title}}</h1>
                {{/if}}
            {{/match}}
            {{#if @site.description}}
                <p class="site-description">Table Roller</p>
            {{else}}
                <p class="site-description">Table Roller</p>
            {{/if}}
        </div>
    {{/match}}

</div>

{{!-- The main content area --}}
<main id="site-main" class="site-main outer">
<div class="inner posts">

    <div class="post-feed">
        {{#get "posts" filter="tag:table" as |tables|}}
            {{#if tables}}
                <div class="table-list">
                    <h3>Available Tables</h3>
                    <ul>
                        {{#foreach tables}}
                            <li>
                                <a href="{{url}}">{{title}}</a>
                            </li>
                        {{/foreach}}
                    </ul>
                </div>
            {{else}}
                <div class="no-tables">
                    <p>No tables found. Create posts with the tag "table" to see them here.</p>
                </div>
            {{/if}}
        {{/get}}
    </div>

</div>
</main>

<style>
    #dice-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        border: none;
        z-index: 9999;
        pointer-events: none; /* Click-through */
        background: transparent;
    }
    
    /* Add this to make the iframe content transparent */
    #dice-overlay-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9999;
        pointer-events: none; /* Click-through */
        background: transparent;
    }
    
    .table-list {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
    }
    
    .table-list ul {
        list-style-type: none;
        padding: 0;
    }
    
    .table-list li {
        margin-bottom: 1rem;
        padding: 1rem;
        border-radius: 5px;
        background-color: #f5f5f5;
        transition: all 0.3s ease;
    }
    
    .table-list li:hover {
        background-color: #e0e0e0;
        transform: translateY(-2px);
    }
    
    .table-list a {
        display: block;
        color: var(--color-darkgrey);
        font-weight: 600;
        text-decoration: none;
    }
    
    .no-tables {
        text-align: center;
        padding: 3rem;
        color: var(--color-midgrey);
    }
</style>

<script>
    function showDiceRoll(roll = "1d20", duration = 5000) {
        // Create a container div with a specific background color that can be made transparent
        const container = document.createElement("div");
        container.id = "dice-overlay-container";
        document.body.appendChild(container);
        
        // Create the iframe inside the container
        const iframe = document.createElement("iframe");
        iframe.id = "dice-overlay";
        
        // Try with a specific color that we can make transparent with CSS
        // Using a very specific green color (#00FF00) that we can key out with CSS
        iframe.src = `https://dice.bee.ac/?chromahex=00FF00&roll&noresult&labelhex=ffffff&dicehex=ff2600&d=${encodeURIComponent(roll)}`;
        
        // Add additional attributes for transparency
        iframe.allowTransparency = "true";
        iframe.style.backgroundColor = "transparent";
        
        // Apply a CSS filter to make the green background transparent
        // This uses a combination of CSS filters to remove the green color
        iframe.style.filter = "chroma(color=#00FF00)";
        
        container.appendChild(iframe);

        setTimeout(() => {
            container.remove();
        }, duration); // remove after roll animation completes
    }

    // Trigger when page loads
    window.addEventListener("load", () => {
        showDiceRoll("1d20");
    });
    
    // Add a button to manually trigger the dice roll for testing
    document.addEventListener("DOMContentLoaded", () => {
        const rollButton = document.createElement("button");
        rollButton.textContent = "Roll Dice";
        rollButton.style.position = "fixed";
        rollButton.style.bottom = "20px";
        rollButton.style.right = "20px";
        rollButton.style.zIndex = "1000";
        rollButton.addEventListener("click", () => {
            showDiceRoll("1d20");
        });
        document.body.appendChild(rollButton);
    });
</script>
