{{!< default}}
{{#contentFor "title"}}Timelines of Pyora{{/contentFor}}
{{!-- Index page for timelines - displays all timelines embedded on one page --}}

<!-- Load TimelineJS assets once for all timelines -->
<link rel="stylesheet" href="{{asset 'timelinejs/css/timeline.css'}}">
<link rel="stylesheet" href="{{asset 'timeline.css'}}">

<style>
  /* Post-style spacing - matches .post-template from screen.css */
  .timeline-index-page {
    padding: max(8vmin, 40px) 0 max(8vmin, 64px);
  }
  .timeline-index-page .article-header {
    padding: 0 0 max(6.4vmin, 40px);
  }

  /* Individual timeline section */
  .timeline-section {
    width: 100%;
    margin-bottom: 4rem;
  }

  .timeline-section-header {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .timeline-section:first-child .timeline-section-header {
    margin-top: 1rem;
  }

  .timeline-section-header h2 {
    margin: 0 0 0.5rem 0;
    font-family: "Waning Star", var(--font-sans);
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .timeline-section-header h2 a {
    color: #fff;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .timeline-section-header h2 a:hover {
    color: var(--ghost-accent-color);
  }

  .timeline-section-meta {
    color: var(--color-secondary-text);
    font-size: 1.1rem;
    margin: 0;
  }

  /* Embedded timeline container - break out to full viewport width */
  .timeline-embed-instance {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: 500px;
    position: relative;
    background: linear-gradient(to bottom right, #3f3f3f, var(--color-darkmode));
  }

  .timeline-embed-instance .timeline-embed-container {
    width: 100%;
    height: 100%;
  }

  /* Hide the data container - it's only used for extracting the sheet URL */
  .timeline-data-container {
    display: none !important;
  }

  /* Access message styling - matches custom-timeline.hbs */
  .timeline-access-message {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100%;
    padding: 2rem;
    background: linear-gradient(to bottom right, #3f3f3f, var(--color-darkmode));
    color: #fff;
  }

  .timeline-access-message h1 {
    margin-bottom: 1rem;
    color: #fff;
  }

  .timeline-access-message p {
    font-size: 2rem;
    margin-bottom: 2rem;
    max-width: 600px;
  }

  .timeline-access-cta {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .timeline-signup-button,
  .timeline-signin-button,
  .timeline-upgrade-button {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    border-radius: 4px;
    font-weight: 600;
    text-decoration: none !important;
    transition: all 0.2s ease;
  }

  .timeline-signup-button,
  .timeline-upgrade-button {
    background-color: var(--ghost-accent-color);
    color: #fff;
  }

  .timeline-signin-button {
    background-color: transparent;
    border: 1px solid #fff;
    color: #fff;
  }

  .timeline-signup-button:hover,
  .timeline-upgrade-button:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .timeline-signin-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  /* Responsive adjustments */
  @media only screen and (max-width: 768px) {
    .timeline-section-header {
      margin-top: 2rem;
      margin-bottom: 1rem;
    }

    .timeline-section-header h2 {
      font-size: 2.2rem;
    }

    .timeline-embed-instance {
      height: 400px;
    }

    .timeline-access-message p {
      font-size: 1rem;
    }

    .timeline-access-cta {
      flex-direction: column;
    }
  }
</style>

<main id="site-main" class="site-main">
<article class="article timeline-index-page">

    <header class="article-header gh-canvas">
        <h1 class="article-title">Timelines</h1>
        <p class="article-excerpt">Explore the history of Pyora through interactive timelines</p>
    </header>

    <section class="gh-content gh-canvas">
    {{!-- Loop through posts in chronological order (oldest first) --}}
    {{#foreach posts}}
      <section class="timeline-section">
        <div class="timeline-section-header">
          <h2><a href="{{url}}">{{title}}</a></h2>
          {{#if custom_excerpt}}
            <p class="timeline-section-meta">{{custom_excerpt}}</p>
          {{/if}}
        </div>

      {{!-- Check post visibility and render accordingly --}}
      {{#has visibility="public"}}
        {{> "timeline-embed"}}
      {{else}}
        {{#has visibility="members"}}
          {{#if @member}}
            {{> "timeline-embed"}}
          {{else}}
            <div class="timeline-embed-instance">
              <div class="timeline-access-message">
                <h1>This timeline is available to Members</h1>
                <p>Sign up or log in to view this timeline.</p>
                <div class="timeline-access-cta">
                  <a href="#/portal/signup" class="timeline-signup-button">Sign up now</a>
                  <a href="#/portal/signin" class="timeline-signin-button">Log in</a>
                </div>
              </div>
            </div>
          {{/if}}
        {{else}}
          {{#has visibility="paid"}}
            {{#if @member.paid}}
              {{> "timeline-embed"}}
            {{else}}
              <div class="timeline-embed-instance">
                <div class="timeline-access-message">
                  <h1>This timeline is available to Supporters</h1>
                  <p>Upgrade your membership to view this timeline.</p>
                  <div class="timeline-access-cta">
                    {{#if @member}}
                      <a href="#/portal/account/plans" class="timeline-upgrade-button">Upgrade now</a>
                    {{else}}
                      <a href="#/portal/signup" class="timeline-signup-button">Sign up now</a>
                      <a href="#/portal/signin" class="timeline-signin-button">Log in</a>
                    {{/if}}
                  </div>
                </div>
              </div>
            {{/if}}
          {{else}}
            {{> "timeline-embed"}}
          {{/has}}
        {{/has}}
      {{/has}}
      </section>
    {{/foreach}}
    </section>

    {{pagination}}

</article>
</main>

<script src="{{asset 'timelinejs/js/timeline.js'}}"></script>

<script>
  // Initialize all timelines when DOM is ready
  document.addEventListener("DOMContentLoaded", function() {
    // Store all timeline instances
    window.timelines = {};

    // Find all timeline embed instances
    const timelineInstances = document.querySelectorAll('.timeline-embed-instance');

    timelineInstances.forEach(function(instance) {
      const timelineId = instance.dataset.timelineId;
      const container = instance.querySelector('.timeline-embed-container');
      const dataContainer = instance.querySelector('.timeline-data-container');

      if (!container || !dataContainer) return;

      // Extract sheet URL from the data container
      const sheetUrl = extractSheetUrl(dataContainer);

      if (sheetUrl) {
        try {
          // Create timeline with configuration
          window.timelines[timelineId] = new TL.Timeline(container, sheetUrl, {
            timenav_position: "bottom",
            initial_zoom: 4,
            scale_factor: 2,
            zoom_sequence: [1,2,3],
            start_at_slide: 0,
            use_bc: false,
            hash_bookmark: false,
            lang: "/assets/timelinejs/timeline-locale.json",
          });

          // Set up BCE date removal for this instance
          setupBCERemoval(container);
        } catch (error) {
          console.error('[Timeline] Failed to initialize timeline ' + timelineId + ':', error);
          container.innerHTML = '<div class="timeline-access-message"><h3>Timeline Error</h3><p>Could not load this timeline. Try refreshing the page.</p></div>';
        }
      } else {
        console.warn('[Timeline] No sheet URL found for timeline ' + timelineId);
        container.innerHTML = '<div class="timeline-access-message"><h3>No Data</h3><p>This timeline has no data source configured.</p></div>';
      }
    });
  });

  // Remove BCE dates and set up observer to keep them removed
  function setupBCERemoval(container) {
    const checkInterval = setInterval(() => {
      const ticks = container.querySelectorAll('.tl-timeaxis-tick');

      if (ticks.length > 0) {
        clearInterval(checkInterval);

        // Remove BCE ticks (negative positions)
        removeBCETicks(container);

        // Watch for timeline changes and remove BCE ticks when they appear
        const axis = container.querySelector('.tl-timeaxis-content-container');
        if (axis) {
          const observer = new MutationObserver(() => removeBCETicks(container));
          observer.observe(axis, { childList: true, subtree: true });
        }
      }
    }, 200);

    // Stop checking after 5 seconds
    setTimeout(() => clearInterval(checkInterval), 5000);
  }

  // Remove timeline ticks with negative positions (BCE dates)
  function removeBCETicks(container) {
    container.querySelectorAll('.tl-timeaxis-tick').forEach(tick => {
      const left = parseFloat(tick.style.left);
      if (left < 0) tick.remove();
    });
  }

  // Extract Google Sheet URL from data container
  function extractSheetUrl(dataContainer) {
    if (!dataContainer) return null;

    // Look for a Ghost bookmark card with a Google Sheets URL
    const bookmarkLink = dataContainer.querySelector('.kg-bookmark-card a.kg-bookmark-container');
    if (bookmarkLink && bookmarkLink.href) {
      const href = bookmarkLink.href;
      if (href.includes('docs.google.com/spreadsheets')) {
        return href;
      }
    }

    // Also check for a simple link to Google Sheets
    const allLinks = dataContainer.querySelectorAll('a');
    for (const link of allLinks) {
      if (link.href && link.href.includes('docs.google.com/spreadsheets')) {
        return link.href;
      }
    }

    return null;
  }
</script>
